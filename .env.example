# A2CR local stdio MCP wrapper example.
# Copy values into your MCP client configuration or local environment.
# Do not commit real local database paths if they reveal private project names.

# Optional: choose where the local A2CR SQLite workspace is stored.
# A2CR_LOCAL_DB=/absolute/path/to/a2cr.db

# Optional: identify the calling client in A2CR metadata.
A2CR_CLIENT_TYPE=mcp
