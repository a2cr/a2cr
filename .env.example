# A2CR local stdio MCP wrapper example.
# Copy values into your MCP client configuration or local environment.
# Do not commit real API keys or local client key files.

A2CR_API_KEY=YOUR_A2CR_API_KEY
A2CR_BASE_URL=https://a2cr.app
A2CR_SERVICE_URL=https://a2cr.app/mcp

# Optional: choose where the local client-encryption key is stored.
# A2CR_CLIENT_KEY_FILE=/absolute/path/to/workbaton.key
# A2CR_CONFIG_DIR=/absolute/path/to/a2cr-config

# Optional: identify the calling client in A2CR metadata.
A2CR_CLIENT_TYPE=mcp

# Localhost targets are refused by default.
# Set this to 1 only for explicit local prototype tests.
A2CR_ALLOW_LOCAL_BASE_URL=0
