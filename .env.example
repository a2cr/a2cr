# Local-only legacy prototype settings. Copy to your local environment only.
# Do not commit real secrets.
# The SQLite WorkBaton API is disabled by default and is not the official AI-agent path.

API_KEY=sk-replace-with-a-local-development-key
FERNET_KEY=replace-with-a-fernet-key
DB_PATH=./a2cr.db
A2CR_ENABLE_LEGACY_LOCAL_API=0

# Official WorkBaton MCP wrapper target. Keep this on the SaaS origin unless
# explicitly testing the legacy local prototype with A2CR_ALLOW_LOCAL_BASE_URL=1.
A2CR_SERVICE_URL=https://a2cr.app/mcp
A2CR_BASE_URL=https://a2cr.app
A2CR_PUBLIC_ORIGIN=http://localhost:8000
# Optional comma-separated override. Production normally derives this from A2CR_SERVICE_URL.
A2CR_ALLOWED_ORIGINS=

# Web SaaS runtime settings. Use real values only in local/private env files.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://a2cr_app:replace-with-password@localhost:5432/a2cr
API_KEY_HASH_SECRET=replace-with-random-hmac-secret
AUDIT_HASH_SECRET=replace-with-random-audit-hmac-secret
A2CR_API_KEY_PREFIX=sk-a2cr
# New Supabase projects use asymmetric JWT signing keys. Prefer JWKS.
SUPABASE_JWKS_URL=https://replace-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Legacy HS256 projects can use SUPABASE_JWT_SECRET instead of SUPABASE_JWKS_URL.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://replace-project-ref.supabase.co/auth/v1

# Public browser env for the React dashboard. These values are safe to expose
# when they are the normal Supabase project URL and anon key.
VITE_SUPABASE_URL=https://replace-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-supabase-anon-key
VITE_A2CR_API_BASE=http://localhost:8000
VITE_A2CR_SERVICE_URL=http://localhost:8000/mcp
